# StockHunter AI — variables d'environnement (copier en .env, ne JAMAIS committer .env)

# Base de données : SQLite en local, PostgreSQL en production (Railway)
SH_DATABASE_URL=sqlite:///./var/stockhunter.db
# SH_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/stockhunter

# SEC EDGAR — gratuit, sans clé, mais User-Agent avec contact OBLIGATOIRE (fair access policy)
SH_SEC_USER_AGENT="StockHunterAI/0.1 votre.email@exemple.com"

# Tiingo — clé gratuite sur https://api.tiingo.com (plan Free : 50 req/h, 1000 req/jour)
SH_TIINGO_API_KEY=

# FRED (Federal Reserve St. Louis) — clé gratuite sur https://fred.stlouisfed.org/docs/api/api_key.html
SH_FRED_API_KEY=

# Finnhub — clé gratuite (profil société, calendrier des résultats ; les chandeliers sont payants)
SH_FINNHUB_API_KEY=

# Univers suivi (fichier CSV) et profondeur d'historique
SH_UNIVERSE_FILE=
SH_PRICE_HISTORY_YEARS=10

# Cache HTTP
SH_CACHE_DIR=./var/cache

# Telegram (phase 4) — laisser vide pour l'instant
SH_TELEGRAM_BOT_TOKEN=
SH_TELEGRAM_CHAT_ID=
